{
  "name": "puente",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "packageManager": "pnpm@11.1.3",
  "scripts": {
    "clear": "rm -r ./android && rm -r ./ios",
    "rebuild": "npx expo prebuild --clean",
    "start": "NODE_ENV=development expo start --reset-cache",
    "start:tunnel": "NODE_ENV=development expo start --reset-cache --tunnel",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "check:nllb": "tsx scripts/check-nllb.ts",
    "check:whisper": "tsx scripts/check-whisper.ts",
    "check:traductor": "tsx scripts/check-traductor-logic.ts",
    "check:catalog": "tsx scripts/check-catalog.ts",
    "check:engines": "tsx scripts/check-engine-slot.ts",
    "check:model-download-job": "tsx scripts/check-model-download-job.ts",
    "check": "pnpm typecheck && pnpm check:catalog && pnpm check:traductor && pnpm check:engines && pnpm check:model-download-job && pnpm lint",
    "build:development:eas": "eas build -p android --profile development",
    "build:development:local": "eas build -p android --profile development --local",
    "build:preview:eas": "eas build -p android --profile preview",
    "build:preview:local": "eas build -p android --profile preview --local",
    "build:production:eas": "eas build -p android --profile production",
    "build:production:local": "eas build -p android --profile production --local"
  },
  "dependencies": {
    "@dr.pogodin/react-native-fs": "^2.39.2",
    "@expo-google-fonts/mulish": "^0.4.2",
    "@expo/ui": "~56.0.15",
    "@huggingface/tokenizers": "^0.1.3",
    "@kesha-antonov/react-native-background-downloader": "4.5.9",
    "expo": "~56.0.8",
    "expo-asset": "^56.0.15",
    "expo-audio": "^56.0.11",
    "expo-constants": "~56.0.16",
    "expo-dev-client": "~56.0.18",
    "expo-device": "~56.0.4",
    "expo-file-system": "^56.0.7",
    "expo-font": "~56.0.5",
    "expo-glass-effect": "~56.0.4",
    "expo-haptics": "^56.0.3",
    "expo-image": "~56.0.9",
    "expo-keep-awake": "^56.0.3",
    "expo-linking": "~56.0.13",
    "expo-localization": "^56.0.6",
    "expo-network": "~56.0.5",
    "expo-router": "~56.2.8",
    "expo-secure-store": "^56.0.4",
    "expo-speech-recognition": "^56.0.1",
    "expo-splash-screen": "~56.0.10",
    "expo-system-ui": "^56.0.5",
    "llama.rn": "^0.12.8",
    "lottie-react-native": "^7.3.8",
    "onnxruntime-react-native": "^1.24.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-sherpa-onnx": "^0.4.3",
    "react-native-worklets": "0.8.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@types/react": "~19.2.15",
    "babel-preset-expo": "~56.0.14",
    "eas-cli": "^21.3.0",
    "eslint": "^9.39.4",
    "eslint-config-expo": "~56.0.4",
    "onnxruntime-node": "1.24.3",
    "tsx": "^4.20.3",
    "typescript": "~6.0.3"
  },
  "private": true
}
